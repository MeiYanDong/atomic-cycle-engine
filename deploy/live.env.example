# Public read and same-raw broadcast endpoints. Do not place private keys here.
BASE_READ_RPC_URL=https://mainnet.base.org
BASE_BROADCAST_RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com

# Both switches must be present before the process can sign or broadcast.
BASE_LIVE_ARM=1
BASE_LIVE_AUTHORIZATION_ID=replace-with-the-approved-canary-scope-id
# Leave empty for deploy, then set to the receipt-attested address before arm/start.
BASE_EXECUTOR_ADDRESS=

# Initial canary hard bounds. Runtime configuration cannot relax the three
# capital-loss limits beyond their compiled policy ceilings.
BASE_MAX_AMOUNT_IN_WEI=3000000000000000
BASE_ETH_RESERVE_FLOOR_WEI=5000000000000000
BASE_FAILED_GAS_CAP_WEI=1000000000000000
BASE_MIN_CONTRACT_PROFIT_WEI=1000000000000
BASE_MIN_NET_PROFIT_WEI=5000000000000
BASE_MAX_FEE_PER_GAS_WEI=1000000000
BASE_GAS_LIMIT_MULTIPLIER_BPS=12000
BASE_L1_FEE_MULTIPLIER_BPS=15000
BASE_OPERATOR_FEE_MULTIPLIER_BPS=12000
BASE_QUOTE_PROFIT_SAFETY_BPS=8000
BASE_VALID_BLOCKS=2
BASE_DEADLINE_SECONDS=20
BASE_POLL_INTERVAL_MS=2000
