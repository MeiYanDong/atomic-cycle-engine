[Unit]
Description=Atomic Cycle Engine bounded Base live canary
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=3
ConditionPathExists=/etc/atomic-cycle-engine/LIVE_APPROVED

[Service]
Type=simple
User=atomic-cycle
Group=atomic-cycle
WorkingDirectory=/opt/atomic-cycle-engine/current
EnvironmentFile=/etc/atomic-cycle-engine/live.env
Environment=BASE_STATE_DIRECTORY=/var/lib/atomic-cycle-engine
Environment=BASE_PUBLIC_HEARTBEAT_PATH=/run/atomic-cycle-portfolio/heartbeat.json
LoadCredential=base-cycle-signer:/etc/atomic-cycle-engine/base-signer.key
UMask=0077
ExecStart=/usr/local/bin/node /opt/atomic-cycle-engine/current/dist/src/cli/base-live-watch.js
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20
KillSignal=SIGTERM
StateDirectory=atomic-cycle-engine
StateDirectoryMode=0700
RuntimeDirectory=atomic-cycle-portfolio
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
MemoryMax=384M
TasksMax=64
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/atomic-cycle-engine

[Install]
WantedBy=multi-user.target
